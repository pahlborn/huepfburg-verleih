{"name":"Hüpfburg-Verleih Peter Ahlborn","short_name":"Hüpfburgen","description":"Hüpfburg mieten für Kindergeburtstag, Vereinsfest oder Firmenfeier: Verfügbarkeit und Preis sofort sehen, online buchen. Selbstabholung oder Lieferung im Raum München, Dachau, Freising und Erding.","start_url":"/huepfburg-verleih/","scope":"/huepfburg-verleih/","display":"standalone","background_color":"#ffffff","theme_color":"#1d5fc4","lang":"de","icons":[{"src":"/huepfburg-verleih/icon-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/huepfburg-verleih/icon-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"/huepfburg-verleih/icon-maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}]}